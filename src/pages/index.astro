---
import Page from '../components/Page.astro';
import { DEFAULT_LANG, type Lang } from '../i18n/utils';

// `Astro.currentLocale` is derived from the URL by Astro's i18n router.
// With `prefixDefaultLocale: false` the site root renders in the default
// locale, which is configured as `en` in astro.config.mjs. No query
// string, no cookie, no detection — the URL is the source of truth.
// We cast to `Lang` because the i18n config guarantees this URL only
// ever resolves to one of the configured locales.
const lang = (Astro.currentLocale ?? DEFAULT_LANG) as Lang;
---
<Page lang={lang} />
