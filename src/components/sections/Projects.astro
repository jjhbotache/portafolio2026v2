---
import { t, type Lang } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import ProjectSheet from './ProjectSheet.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => (a.data.importance ?? 0) - (b.data.importance ?? 0));
  
const parsedProjects = projects.map((proj) => {
  const title = proj.data.title[lang];
  const description = proj.data.description[lang];
  const technologies = proj.data.technologies?.[lang] ?? [];
  const content = proj.data.content[lang];
  return {
    id: proj.id,
    data: {
      title,
      description,
      img: proj.data.img,
      video: proj.data.video,
      technologies,
      links: proj.data.links.map((link) => ({
        url: link.url,
        label: link.label[lang],
      })),
      content,
    },
    texts :{
      hover: t(lang, 'sections.projects.hover')
    }
  };
});

// Distribute projects across N columns; each column scrolls at a different
// speed so the section feels layered. 4 columns is a sweet spot for desktop
// and collapses to 2 on tablet, 1 on mobile.
---
<section class="projects" data-section="projects" id="projects">
  <h2 class="projects__title" data-projects-title data-lang={lang}> {t(lang, 'sections.projects.title')} </h2>

  <!-- Each column scrolls at its own speed (irregular) and direction. The
       inner track is duplicated so the columns can loop without a visible
       jump. -->
  <div class="projects__columns" data-projects-columns> 
    <!-- injected projects -->
  </div>
  
  <!-- save projects with js -->
   <script is:inline type="application/json" id="projects-data" set:html={JSON.stringify(parsedProjects)}/>
  
  <ProjectSheet lang={lang} />
</section>

<style>
  
  
  /* Register custom properties so the browser can interpolate them smoothly
     across @keyframes. Without @property the values are treated as opaque
     strings, so the gradient snaps between keyframes instead of flowing. */
  @property --grad1-x { syntax: '<percentage>'; inherits: true; initial-value: 66%; }
  @property --grad1-y { syntax: '<percentage>'; inherits: true; initial-value: 81%; }
  @property --grad2-x { syntax: '<percentage>'; inherits: true; initial-value: 20%; }
  @property --grad2-y { syntax: '<percentage>'; inherits: true; initial-value: 57%; }
  @property --grad3-x { syntax: '<percentage>'; inherits: true; initial-value: 90%; }
  @property --grad3-y { syntax: '<percentage>'; inherits: true; initial-value: 30%; }
  @property --grad4-x { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  @property --grad4-y { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
    
  @property --perspective { syntax: '<length>'; inherits: true; initial-value: 5px; }

  .projects {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100vh;       
    padding: 4rem var(--shell-pad-x) 8rem;
    overflow: hidden;
    background-color: hsla(195, 48%, 60%, 1);
    background-image:
    radial-gradient(at var(--grad1-x) var(--grad1-y), hsla(210, 100%, 39%, .7) 0px, transparent 50%),
    radial-gradient(at var(--grad2-x) var(--grad2-y), hsla(193, 100%, 45%, .7) 0px, transparent 50%),
    radial-gradient(at var(--grad3-x) var(--grad3-y), hsla(279, 76%, 50%, .7) 0px, transparent 50%),
    radial-gradient(at var(--grad4-x) var(--grad4-y), hsla(180,99%,79%,1) 0px, transparent 50%);
    
    
    perspective: var(--perspective);
    perspective-origin: bottom center;
    transform-style: preserve-3d;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 100%);
            mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 100%);
  }
  
  /* only add animation for desktop, and only if the user has not
   * requested reduced motion (the @media block below further narrows
   * it to `no-preference`). The duration was 3s before — that's a
   * full repaint of the 100vh background every 3 seconds. 6s halves
   * the repaint cost with virtually no visual difference (the loop
   * is meant to be ambient, not perceived). */
  @media (min-width: 768px) {
    .projects {
      animation: gradientMove 6s linear infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects {
      animation: none !important;
    }
  }

  @keyframes gradientMove {
    0%, 100% { --grad1-x: 66%; --grad1-y: 81%; --grad2-x: 20%; --grad2-y: 57%; --grad3-x: 90%; --grad3-y: 30%; --grad4-x: 1%; --grad4-y: 5%;    }
    12% { --grad1-x: 55%; --grad1-y: 95%; --grad2-x: 25%; --grad2-y: 45%; --grad3-x: 80%; --grad3-y: 60%; --grad4-x: 42%; --grad4-y: 75%;    }
    25% { --grad1-x: 50%; --grad1-y: 90%; --grad2-x: 30%; --grad2-y: 40%; --grad3-x: 75%; --grad3-y: 50%; --grad4-x: 50%; --grad4-y: 50%;    }
    37% { --grad1-x: 70%; --grad1-y: 70%; --grad2-x: 10%; --grad2-y: 55%; --grad3-x: 65%; --grad3-y: 35%; --grad4-x: 60%; --grad4-y: 40%;    }
    50% { --grad1-x: 80%; --grad1-y: 60%; --grad2-x: 15%; --grad2-y: 70%; --grad3-x: 60%; --grad3-y: 20%; --grad4-x: 70%; --grad4-y: 30%;    }
    62% { --grad1-x: 35%; --grad1-y: 45%; --grad2-x: 75%; --grad2-y: 25%; --grad3-x: 90%; --grad3-y: 65%; --grad4-x: 80%; --grad4-y: 20%;    }
    75% { --grad1-x: 40%; --grad1-y: 50%; --grad2-x: 70%; --grad2-y: 30%; --grad3-x: 85%; --grad3-y: 75%; --grad4-x: 90%; --grad4-y: 10%;    }
    87% { --grad1-x: 60%; --grad1-y: 85%; --grad2-x: 35%; --grad2-y: 50%; --grad3-x: 70%; --grad3-y: 40%; --grad4-x: 100%; --grad4-y: 0%;    }
  }
  
  


  .projects__title {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(.1); ;
    opacity: .2;
    margin: 0;
    font-family: var(--ff-pixeloid);
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    letter-spacing: 0.04em;
    background: linear-gradient(to bottom right, var(--c-primary) 0%, var(--c-violet-deep) 65%, var(--c-primary-deep) 100%);
    text-shadow: 0 0 20px rgba(0, 181, 232, 0.15);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    line-height: 1.3;
    white-space: nowrap;
  }

  .projects__columns  {
    position: absolute;
    /* bg for debug */
    /* background: linear-gradient(to bottom, red 0%,red 48%, green 49%, green 51%,red 52%, red 100%);  */
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin: 0 auto;

    align-items: flex-start;
    transform-origin: center bottom;
    /* transform: rotateX(30deg) translate(0,50%);    se establece con gsap */
  }
</style>

<style is:global>
  .projects__column {
    position: relative;
    display: flex;
    height: auto;
    flex-direction: column;
    gap: 2rem;
    border-radius: 0.5rem;
    z-index: 1;
    flex: 1 1 0;
    min-width: 0;
    max-width: 90vw;
    transform: translateY(5%);
  }
  .projects__column:hover { z-index: 2; }


  .projects__card {
    background: rgba(8, 12, 24, 1);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    /* The previous `backdrop-filter: blur(6px)` on the base card was
     * wasted: the background is fully opaque (`rgba(8, 12, 24, 1)`),
     * so there is nothing to blur. Removing it eliminates a per-card
     * composited surface that the browser had to recompute on every
     * hover transform. */
    width: 100%;

    font: var(--ff-geist-pixel);
    overflow: hidden;
    border-radius: 0.75rem;
    z-index: 1;
    transform-style: preserve-3d;

  }
  .projects__card:hover {
    /* Explicit transition list (was `transition: all`). Capturing all
     * properties would also animate the `border-color` and `background`
     * if those change in the future. */
    transition: transform 100ms ease,
                box-shadow 100ms ease;

    transform: scale(1.01) ;
    box-shadow: 0 0 .5rem rgb(0, 0, 0);
    z-index: 3;
  }

  @media (width > 768px) {
    /* No `display: none` here anymore: the previous `display: none;
     * opacity: 0;` was being overridden by the `display: grid;` two
     * lines below, making the `display: none` dead code. The pseudo
     * is now controlled purely by opacity, and revealed via the
     * `:hover::after` rule below. */
    .projects__card::after {
      opacity: 0;
      content: attr(data-hover);
      position: absolute;
      display: grid;
      place-items: center;
      font-family: var(--ff-pixeloid);
      font-size: 2rem;
      color: var(--c-text);
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(4px);
      border-radius: 0.75rem;
      text-shadow: 0 0 .4rem rgba(0, 0, 0, 0.5);
      z-index: 4;
      transition: opacity 0.3s ease;
      transition-delay: 1s;
    }
  }
  
  .projects__card:hover::after {
    opacity: 1;
    cursor: pointer;
  }

  .projects__card-media {
    display: block;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .projects__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .projects__card:hover .projects__card-image { transform: scale(1.05); }

  .projects__card-body {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .projects__card-title {
    margin: 0;
    font-family: var(--ff-pixeloid);
    font-size: 0.95rem;
    color: var(--c-text);
  }

  .projects__card-description {
    /* `max-height` (instead of `height`) lets the description grow naturally
       when line-clamp works, and falls back to clipping after exactly 3 lines
       worth of content if the browser doesn't honor line-clamp. The
       multiplier matches the `line-height` below so the cutoff lands on a
       line boundary, not in the middle of a line. */
    max-height: calc(1.45em * 3);
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .projects__card-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .projects__card-tech {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 181, 232, 0.1);
    color: var(--c-secondary);
    font-size: 0.65rem;
    border: 1px solid rgba(0, 181, 232, 0.25);
  }

  .projects__card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .projects__card-link {
    font-size: 0.7rem;
    color: var(--c-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .projects__card-link:hover { color: var(--c-text); }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  
  const lang = document.documentElement.lang as 'es' | 'en';
  
  
  interface RawProject {
  id: string;
  data: {
    title: string
    description: string;
    img: string;
    hidden?: boolean;
    importance?: number;
    video?: string;
    technologies?:  string[];
    content?: string;
    links: { url: string; label: string }[];
  },
  texts: {
    hover: string;
  }
}
  


  // Breakpoints MUST match the CSS media queries at the bottom of this file
  // (≤425px → 1 column, ≤768px → 2 columns, else 3). If the CSS changes, this
  // function must change too, otherwise the columns rendered in the DOM will
  // not match the columns the CSS is actually displaying.
  const getColumnCount = (): number => {
    const w = window.innerWidth;
    if (w <= 425) return 1;
    if (w <= 768) return 2;
    return 3;
  };


  // Redistributes the original project cards (ignoring clones used for the
  // scroll loop) across the first `cols` columns as evenly as possible, and
  // empties the rest. Runs both on first load and on breakpoint changes.
  // The DOM nodes of each column never change (so GSAP refs and ScrollTrigger
  // keep working); only their child <article> elements are re-arranged.
  const distribute = (cols: number, projects: RawProject[]) => {
    const projectsContainer = document.querySelector<HTMLElement>('[data-projects-columns]');
      
    // create the cols and insert them
    projectsContainer?.replaceChildren(
      ...Array.from(
        { length: cols },
        () => {
        const col = document.createElement('div');
        col.className = 'projects__column';
        col.setAttribute('data-projects-column', '');
        return col;
      }),
    );
    
    // distribute the projects across the columns
    
    const projectsAmountByCol = Math.ceil(projects.length / cols);
    const columns = document.querySelectorAll<HTMLElement>('[data-projects-column]');
    columns.forEach((col, i) => {
      col.replaceChildren(
        ...projects.slice(i * projectsAmountByCol, (i + 1) * projectsAmountByCol).map((proj) => {
          const card = `<article id="${proj.id}" class="projects__card" data-projects-card data-hover="${proj.texts.hover}">
            <div class="projects__card-media" aria-hidden="true">
              <img
                src="${proj.data.img}"
                alt=""
                class="projects__card-image"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            </div>
            <div class="projects__card-body">
              <h3 class="projects__card-title">
                <span data-lang="${lang}">${proj.data.title}</span>
              </h3>
              <p class="projects__card-description">
                <span data-lang="${lang}">${proj.data.description}</span>
              </p>
            </div>
          </article>`;
          return new DOMParser().parseFromString(card, 'text/html').body.firstChild as HTMLElement;
        }),
      );
    }); 
  };

  const projectsData = JSON.parse(document.querySelector<HTMLElement>('#projects-data')?.innerHTML || '[]') as RawProject[];
  const projectsWithClones = [...projectsData, ...projectsData.reverse().slice(3)]; // add clones for the scroll loop
  
  const getProjects = () => window.innerWidth <= 768 ? projectsData : projectsWithClones;
  const init = () => {
    distribute(getColumnCount(), getProjects());

    // prepare the cards to be pressed (must run for both regular and
    // reduced-motion users, so the project sheet still opens on click)
    document.querySelectorAll('[data-projects-card]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.id;
        const event = new CustomEvent('portafolio:open-sheet', {
          detail: { id },
          bubbles: true,
        });
        window.dispatchEvent(event);

      });
    });

    // Reduced-motion fallback: render the columns statically, without
    // the GSAP scrub / 3D perspective transition. The columns are
    // already laid out in their final position by `distribute()`,
    // so we just need to skip the timeline / ScrollTrigger below.
    if (
      typeof window !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      // Open up the section so the static column layout is scrollable
      // naturally. The columns container is left at its default
      // position (no 3D perspective) — the click listeners above stay
      // active so the project sheet still opens.
      const section = document.querySelector<HTMLElement>('#projects');
      if (section) {
        section.style.overflow = 'auto';
        section.style.height = 'auto';
        section.style.minHeight = '100vh';
      }
      const columnsContainer = document.querySelector<HTMLElement>('[data-projects-columns]');
      if (columnsContainer) {
        columnsContainer.style.position = 'relative';
        columnsContainer.style.transform = 'none';
      }
      return;
    }

    const columnsContainer = document.querySelector<HTMLElement>('[data-projects-columns]');
    const columns = document.querySelectorAll<HTMLElement>('[data-projects-column]');
    const section = document.querySelector<HTMLElement>('#projects');
    const title = document.querySelector<HTMLElement>('[data-projects-title]');
    if (!title || !section ) return;


    


    const timeline = gsap.timeline({ paused: true });
    timeline.to(title, {
      scale: 1,
      opacity: 1,
      ease: 'power4.out',
      duration: 1,
    },0);
    // 2

    gsap.set(columnsContainer, { rotateX: '30deg',scale: 5 });
    gsap.set(columns, { y: columnsContainer?.offsetHeight });
    timeline.to(columnsContainer, {
      rotateX: '5deg',
      duration: 1
    },">-=1");
    timeline.to(columnsContainer, {
      scale: 1,
      duration: .5
    },"<");
    timeline.to(section, {
      "--perspective": '400px',
      duration: 2
    },"<");
    timeline.to(columns, {
      yPercent: -120,
      ease: "linear",
      duration: 3,
    },"<");
    
    

    // The pin/scrub lasts for `+=5000` of scroll, so during that window
    // the columns are continuously transformed. Promote them to a GPU
    // layer only while the trigger is active, then release it so the
    // layers don't burn VRAM after the section is offscreen.
    const promoteColumns = () => gsap.set(columns, { willChange: 'transform, opacity' });
    const demoteColumns = () => gsap.set(columns, { willChange: 'auto' });

    ScrollTrigger.create({
      trigger: section,
      pin: true,
      pinSpacing: true,
      start: 'top top',
      end: '+=7000',
      scrub: 0.5,
      animation: timeline,
      onEnter: promoteColumns,
      onEnterBack: promoteColumns,
      onLeave: demoteColumns,
      onLeaveBack: demoteColumns,
    });
    
    window.addEventListener('resize', () => {
          ScrollTrigger.refresh();
    });
    
  };


  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
