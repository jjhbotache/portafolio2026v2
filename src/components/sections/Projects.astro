---
import { t, type Lang } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import { resolve } from '../../lib/collectionHelpers';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => (a.data.importance ?? 0) - (b.data.importance ?? 0));

// Distribute projects across N columns; each column scrolls at a different
// speed so the section feels layered. 4 columns is a sweet spot for desktop
// and collapses to 2 on tablet, 1 on mobile.
const NUM_COLUMNS = 3;
const columns: typeof projects[] = Array.from({ length: NUM_COLUMNS }, () => []);
projects.forEach((p, i) => columns[i % NUM_COLUMNS].push(p));
---
<section class="projects bg-projects" data-section="projects" id="projects">
  <h2 class="projects__title" data-projects-title data-lang={lang}> {t(lang, 'sections.projects.title')} </h2>

  <!-- Each column scrolls at its own speed (irregular) and direction. The
       inner track is duplicated so the columns can loop without a visible
       jump. -->
  <div class="projects__columns" data-projects-columns>
    {columns.map((col, colIndex) => (
      <div
        class="projects__column"
        data-projects-column
        data-column={colIndex}
        data-direction={colIndex % 2 === 0 ? 'up' : 'down'}
      >
        <div class="projects__column-track">
          {col.map((proj, index) => {
            const titleEs = resolve(proj.data.title, 'es');
            const titleEn = resolve(proj.data.title, 'en');
            const descEs = resolve(proj.data.description, 'es');
            const descEn = resolve(proj.data.description, 'en');
            const techEs = (proj.data.technologies.es ?? []).slice(0, 4);
            const techEn = (proj.data.technologies.en ?? []).slice(0, 4);
            // First card in each column is the one most likely to be the
            // LCP element when Projects enters the viewport. Load it eagerly
            // with high fetchpriority so the browser doesn't compete with
            // late-discovered scripts for that image.
            const isFirstInColumn = index === 0;
            return (
              <article class="projects__card" data-projects-card data-hover={t(lang, 'sections.projects.hover')} >
                <a
                  href={proj.data.video?.startsWith('http') ? proj.data.video : '#'}
                  target={proj.data.video?.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class="projects__card-media"
                >
                  <img
                    src={proj.data.img}
                    alt={titleEs}
                    class="projects__card-image"
                    loading={isFirstInColumn ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={isFirstInColumn ? 'high' : 'auto'}
                  />
                </a>
                <div class="projects__card-body">
                  <h3 class="projects__card-title">
                    <span data-lang="es">{titleEs}</span>
                    <span data-lang="en">{titleEn}</span>
                  </h3>
                  <p class="projects__card-description">
                    <span data-lang="es">{descEs}</span>
                    <span data-lang="en">{descEn}</span>
                  </p>
                  <div class="projects__card-techs">
                    {techEs.map((_, i) => (
                      <span class="projects__card-tech">
                        <span data-lang="es">{techEs[i]}</span>
                        <span data-lang="en">{techEn[i]}</span>
                      </span>
                    ))}
                  </div>
                  <div class="projects__card-links">
                    {proj.data.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="projects__card-link"
                      >
                        <span data-lang="es">{resolve(link.label, 'es')}</span>
                        <span data-lang="en">{resolve(link.label, 'en')}</span>
                      </a>
                    ))}
                  </div>
                </div>
              </article>
            );
          })}
          {col.map((proj) => {
            const titleEs = resolve(proj.data.title, 'es');
            const titleEn = resolve(proj.data.title, 'en');
            const descEs = resolve(proj.data.description, 'es');
            const descEn = resolve(proj.data.description, 'en');
            return (
              <article class="projects__card projects__card--clone" data-projects-card data-hover={t(lang, 'sections.projects.hover')}>
                <a
                  href={proj.data.video?.startsWith('http') ? proj.data.video : '#'}
                  target={proj.data.video?.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class="projects__card-media"
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <img
                    src={proj.data.img}
                    alt=""
                    class="projects__card-image"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                </a>
                <div class="projects__card-body">
                  <h3 class="projects__card-title">
                    <span data-lang="es">{titleEs}</span>
                    <span data-lang="en">{titleEn}</span>
                  </h3>
                  <p class="projects__card-description">
                    <span data-lang="es">{descEs}</span>
                    <span data-lang="en">{descEn}</span>
                  </p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  
  
  /* Register custom properties so the browser can interpolate them smoothly
     across @keyframes. Without @property the values are treated as opaque
     strings, so the gradient snaps between keyframes instead of flowing. */
  @property --grad1-x { syntax: '<percentage>'; inherits: true; initial-value: 66%; }
  @property --grad1-y { syntax: '<percentage>'; inherits: true; initial-value: 81%; }
  @property --grad2-x { syntax: '<percentage>'; inherits: true; initial-value: 20%; }
  @property --grad2-y { syntax: '<percentage>'; inherits: true; initial-value: 57%; }
  @property --grad3-x { syntax: '<percentage>'; inherits: true; initial-value: 90%; }
  @property --grad3-y { syntax: '<percentage>'; inherits: true; initial-value: 30%; }
  @property --grad4-x { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  @property --grad4-y { syntax: '<percentage>'; inherits: true; initial-value: 50%; }

  .projects {
    position: relative;
    width: 100%;
    height: 100vh;       
    padding: 4rem var(--shell-pad-x) 8rem;
    overflow: hidden;
    background-color: hsla(195, 48%, 60%, 1);
    background-image:
    radial-gradient(at var(--grad1-x) var(--grad1-y), hsla(210, 100%, 39%, .7) 0px, transparent 50%),
    radial-gradient(at var(--grad2-x) var(--grad2-y), hsla(193, 100%, 45%, .7) 0px, transparent 50%),
    radial-gradient(at var(--grad3-x) var(--grad3-y), hsla(279, 76%, 50%, .7) 0px, transparent 50%),
    radial-gradient(at var(--grad4-x) var(--grad4-y), hsla(180,99%,79%,1) 0px, transparent 50%);
    animation: gradientMove 3s linear infinite;
    
    perspective: 500px;
    perspective-origin: bottom center;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 100%);
            mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 100%);
  }

  @keyframes gradientMove {
    0%, 100% { --grad1-x: 66%; --grad1-y: 81%; --grad2-x: 20%; --grad2-y: 57%; --grad3-x: 90%; --grad3-y: 30%; --grad4-x: 1%; --grad4-y: 5%;    }
    12% { --grad1-x: 55%; --grad1-y: 95%; --grad2-x: 25%; --grad2-y: 45%; --grad3-x: 80%; --grad3-y: 60%; --grad4-x: 42%; --grad4-y: 75%;    }
    25% { --grad1-x: 50%; --grad1-y: 90%; --grad2-x: 30%; --grad2-y: 40%; --grad3-x: 75%; --grad3-y: 50%; --grad4-x: 50%; --grad4-y: 50%;    }
    37% { --grad1-x: 70%; --grad1-y: 70%; --grad2-x: 10%; --grad2-y: 55%; --grad3-x: 65%; --grad3-y: 35%; --grad4-x: 60%; --grad4-y: 40%;    }
    50% { --grad1-x: 80%; --grad1-y: 60%; --grad2-x: 15%; --grad2-y: 70%; --grad3-x: 60%; --grad3-y: 20%; --grad4-x: 70%; --grad4-y: 30%;    }
    62% { --grad1-x: 35%; --grad1-y: 45%; --grad2-x: 75%; --grad2-y: 25%; --grad3-x: 90%; --grad3-y: 65%; --grad4-x: 80%; --grad4-y: 20%;    }
    75% { --grad1-x: 40%; --grad1-y: 50%; --grad2-x: 70%; --grad2-y: 30%; --grad3-x: 85%; --grad3-y: 75%; --grad4-x: 90%; --grad4-y: 10%;    }
    87% { --grad1-x: 60%; --grad1-y: 85%; --grad2-x: 35%; --grad2-y: 50%; --grad3-x: 70%; --grad3-y: 40%; --grad4-x: 100%; --grad4-y: 0%;    }
  }
  
  


  .projects__title {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(.1); ;
    opacity: .2;
    margin: 0;
    font-family: var(--ff-pixeloid);
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    letter-spacing: 0.04em;
    background: linear-gradient(120deg, #e3fffc 0%, #b790ff 65%, #b6fffa 100%);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    line-height: 1.3;
    white-space: nowrap;
    text-shadow: 0 0 30px rgba(0, 181, 232, 0.15);
  }

  /* define a property */
  @property --rotation-x-deg {
    syntax: '<angle>';
    inherits: true;
    initial-value: 45deg;
  }
  
  /* @keyframes rotateColumns {
    0%, 100% { --rotation-x-deg: 0deg; }
    50% { --rotation-x-deg: 25deg; }
  } */
  .projects__columns {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin: 0 auto;
    
    transform: rotateX(var(--rotation-x-deg)) translateY(150%);
    /* animation: rotateColumns 5s ease 0s infinite normal; */
  }
  
  
  

  .projects__column {
    position: relative;
    border-radius: 0.5rem;
    height: 70vh;
    z-index: 1;
  }
  .projects__column:hover { z-index: 2; }

  .projects__column-track {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    perspective: 1000px;
    perspective-origin: bottom center;
  }

  .projects__card {
    background: rgba(8, 12, 24, 1);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    backdrop-filter: blur(6px);
    
    font: var(--ff-geist-pixel);
    overflow: hidden;
    border-radius: 0.75rem;
    z-index: 1;
    
    
  }
  .projects__card:hover {
    /* delayed transition of all and takes 3 seconds */
    transition: all 100ms ease;
    
    transform: scale(1.01) ;
    will-change: transform, z-index;
    box-shadow: 0 0 .5rem rgb(0, 0, 0);
    transform-style: preserve-3d;
    z-index: 3;
  }
  
  .projects__card::after {
    display: none;
    opacity: 0;
    content: attr(data-hover);
    position: absolute;
    display: grid;
    place-items: center;
    font-family: var(--ff-pixeloid);
    font-size: 2rem;
    color: var(--c-text);
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
    border-radius: 0.75rem;
    text-shadow: 0 0 .4rem rgba(0, 0, 0, 0.5);
    z-index: 4;
  }
  
  .projects__card:hover::after {
    display: grid;
    opacity: 1;
    transition: opacity 0.3s ease;
    transition-delay: 1s;
    cursor: pointer;
  }

  .projects__card-media {
    display: block;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .projects__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .projects__card:hover .projects__card-image { transform: scale(1.05); }

  .projects__card-body {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .projects__card-title {
    margin: 0;
    font-family: var(--ff-pixeloid);
    font-size: 0.95rem;
    color: var(--c-text);
  }

  .projects__card-description {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--c-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .projects__card-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .projects__card-tech {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 181, 232, 0.1);
    color: var(--c-secondary);
    font-size: 0.65rem;
    border: 1px solid rgba(0, 181, 232, 0.25);
  }

  .projects__card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .projects__card-link {
    font-size: 0.7rem;
    color: var(--c-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .projects__card-link:hover { color: var(--c-text); }

  @media (max-width: 1100px) {
    .projects__columns { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .projects__columns { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const init = () => {
    const columns = Array.from(
      document.querySelectorAll<HTMLElement>('[data-projects-column]'),
    );
    const section = document.querySelector<HTMLElement>('#projects');
    const title = document.querySelector<HTMLElement>('[data-projects-title]');
    if (!title || !section || columns.length === 0) return;

    const timeline = gsap.timeline({ paused: true });
    timeline.to(title, {
      scale: 1,
      opacity: 1,
      ease: 'power1.inOut',
      duration: 2,
    });
    // 2

    columns.forEach((col, i) => {
      timeline.to(
        col,
        {
          yPercent: -700,
          duration: 10,
        },
        i == 0 ? '>-=1' : '<',
      );
    });
    // 11.5
    
    

    
    
    // inserted
    timeline.to("[data-projects-columns]", {
      "--rotation-x-deg": "5deg",
      ease: 'power4.inOut',
      duration: 5
    },.5);
    

    // The pin/scrub lasts for `+=3000` of scroll, so during that window the
    // columns are continuously transformed. Promote them to a GPU layer only
    // while the trigger is active, then release it so the layers don't burn
    // VRAM after the section is offscreen.
    const promoteColumns = () => gsap.set(columns, { willChange: 'transform' });
    const demoteColumns = () => gsap.set(columns, { willChange: 'auto' });

    ScrollTrigger.create({
      trigger: section,
      pin: true,
      start: 'top top',
      end: '+=5000',
      scrub: 0.5,
      animation: timeline,
      onEnter: promoteColumns,
      onEnterBack: promoteColumns,
      onLeave: demoteColumns,
      onLeaveBack: demoteColumns,
    });
  };


  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
