---
import { t, type Lang } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { resolve, formatPeriod } from '../../lib/collectionHelpers';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;

const entries = (await getCollection('experiences'))
  .sort((a, b) =>  (b.data.importance ?? 0) - (a.data.importance ?? 0));

// Pre-parse the bilingual `content` frontmatter field to HTML so the
// detail overlay can inject it with `set:html` (instead of relying on
// the markdown body via `astro:content`'s render â€” which renders only
// the (placeholder) body). Both languages are pre-computed so a locale
// switch does not require a re-fetch.
const resolved = entries.map((entry) => {
  const contentEs = marked.parse(resolve(entry.data.content, 'es'), { async: false }) as string;
  const contentEn = marked.parse(resolve(entry.data.content, 'en'), { async: false }) as string;
  const contentHtml = lang === 'es' ? contentEs : contentEn;
  return {
    id: entry.id,
    data: entry.data,
    contentHtml,
  };
});
---
<section
  class="experience bg-experience"
  data-section="experience"
  id="experienceDetailedView"
>
  <div class="experience-content" data-experience-content>
    <h2 class="experience__title" data-section-title="experience" data-lang={lang}> {t(lang, 'sections.experience.title')}</h2>

    <div class="experience__viewport" data-experience-viewport>
      <div class="experience-track experience__track" data-experience-track>
        {resolved.map((exp, index) => {
          const title = resolve(exp.data.title, lang);
          const period = formatPeriod(exp.data.start, exp.data.end, lang);
          const desc = resolve(exp.data.description, lang);
          const tech = exp.data.technologies[lang];
          const toggle = t(lang, 'experience.viewMore');
          const close = t(lang, 'experience.closeDetail');
          const empty = t(lang, 'experience.noImages');
          return (
            <article
              class="experience__card"
              data-experience-card
              data-card-id={exp.id}
              id={`experienceCard-${exp.id}`}
              data-deferred={index >= 3 ? '' : null}
            >
            <div class="experience__card-info">
              <h3 class="experience__card-title">
                <span data-lang={lang}>{title}</span>
              </h3>
              <div class="experience__card-enterprises">
                {exp.data.enterprises.map((ent) => {
                  const name = resolve(ent.name, lang);
                  return (
                    <a
                      href={ent.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="experience__card-enterprise"
                    >
                      <img src={ent.logo} alt={name} class="experience__card-enterprise-logo" loading="lazy" />
                      <span data-lang={lang}>{name}</span>
                    </a>
                  );
                })}
              </div>
              <p class="experience__card-period">
                <span data-lang={lang}>{period}</span>
              </p>
              <p class="experience__card-description">
                <span data-lang={lang}>{desc}</span>
              </p>
              <button
                type="button"
                class="experience__card-toggle"
                data-experience-toggle={exp.id}
                aria-expanded="false"
              >
                <span data-lang={lang}>{toggle}...</span>
              </button>
            </div>

            <div class="experience__card-slider">
              {exp.data.imgs.length > 0 ? (
                <div
                  class="experience__swiper swiper"
                  data-experience-swiper
                  data-card-id={exp.id}
                >
                  <div class="swiper-wrapper experience__swiper-wrapper">
                    {exp.data.imgs.map((src) => (
                      <div class="swiper-slide experience__swiper-slide">
                        <button
                          type="button"
                          class="experience__swiper-image-button"
                          data-lightbox-src={src}
                          data-lightbox-alt={title}
                          aria-label={title}
                        >
                          <img
                            src={src}
                            alt={title}
                            class="experience__swiper-image"
                            loading="lazy"
                            decoding="async"
                          />
                        </button>
                      </div>
                    ))}
                  </div>
                  <div class={`swiper-pagination experience__swiper-pagination-${exp.id}`}></div>
                  <div class="swiper-button-prev experience__swiper-nav"></div>
                  <div class="swiper-button-next experience__swiper-nav"></div>
                </div>
              ) : (
                <div class="experience__card-empty">
                  <span data-lang={lang}>{empty}</span>
                </div>
              )}
            </div>

            <!-- Detail overlay (technologies + full content). Shown when the
                 user clicks the .experience__card-toggle. CSS toggles it. -->
            <div class="experience__card-overlay" data-experience-overlay={exp.id}>
              <button
                type="button"
                class="experience__card-close"
                data-experience-close={exp.id}
                aria-label={close}
              >x</button>
              
              <div class="experience__card-overlay-inner">
                <div class="experience__card-techs">
                  {tech.map((item, i) => (
                    <span
                      class="experience__card-tech"
                      style={`transition-delay: ${300 + i * 100}ms;`}
                      data-delay={300 + i * 100}
                    >
                      <span data-lang={lang}>{item}</span>
                    </span>
                  ))}
                </div>
                <div
                  id={`experienceContent-${exp.id}`}
                  class="experience__card-content"
                  data-experience-content
                  set:html={exp.contentHtml}
                />

                {/* Open every link in a new tab and underline them. Done in
                 * an inline script per card so the post-processing runs as
                 * soon as the parsed HTML lands in the DOM. `rel="noopener
                 * noreferrer"` is added for tabnabbing protection. */}
                <script is:inline define:vars={{ expId: exp.id }}>
                  (function () {
                    var container = document.getElementById('experienceContent-' + expId);
                    if (!container) return;
                    container.querySelectorAll('a').forEach(function (link) {
                      link.setAttribute('target', '_blank');
                      link.setAttribute('rel', 'noopener noreferrer');
                      link.style.textDecoration = 'underline';
                    });
                    // Stop the toggle's "click outside collapses" handler
                    // from firing when the user clicks inside the content.
                    container.addEventListener('click', function (e) {
                      e.stopPropagation();
                    });
                  })();
                </script>
              </div>
              
            </div>
          </article>
          );
        })}
      </div>
    </div>

    <div class="experience__controls">
      <button
        type="button"
        class="experience__see-all"
        data-experience-see-all
        disabled
      >
        <span data-lang={lang}>{t(lang, 'experience.seeAll')}</span>
      </button>
    </div>
  </div>

  <!-- Lightbox: opens when a swiper image is clicked. Rendered once at
       the section level so the click target (image button) only needs to
       toggle attributes on this single shared element. -->
  <div
    class="experience__lightbox"
    data-experience-lightbox
    aria-hidden="true"
    role="dialog"
  >
    <button
      type="button"
      class="experience__lightbox-close"
      data-experience-lightbox-close
      aria-label="Close"
    >x</button>
    <img
      class="experience__lightbox-image"
      data-experience-lightbox-image
      alt=""
    />
  </div>

</section>

<style>
  .experience {
    position: relative;
    width: 100%;
    padding: var(--shell-pad-x);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    overflow: hidden;
    background-color: #0a0d1f;
    background-image:
      radial-gradient(at 5% 12%, hsla(241, 57%, 18%, 0.55) 0%, transparent 60%),
      radial-gradient(at 45% 10%, hsla(293, 60%, 32%, 0.55) 0%, transparent 60%),
      radial-gradient(at 80% 18%, hsla(241, 56%, 26%, 0.55) 0%, transparent 60%),
      radial-gradient(at 52% 60%, hsla(253, 59%, 25%, 0.55) 0%, transparent 60%),
      radial-gradient(at 28% 75%, hsla(293, 60%, 32%, 0.55) 0%, transparent 60%);
  }

  /* Pinned content layer. While the user scrolls, ScrollTrigger keeps
     this element glued to the viewport so only the GSAP timeline
     progresses. */
  .experience-content {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }


  .experience__title {
    align-self: self-start;
    font-family: var(--ff-tron);
    font-size: clamp(2rem, 2vw, 3rem);
    letter-spacing: 0.05em;
    color: transparent;
    background: linear-gradient(to top left, var(--c-primary) 0%, var(--c-secondary) 80%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--ff-pixeloid);
    z-index: 2;
  }


  .experience__viewport {
    position: relative;
    width: 100%;
    max-width: 1100px;
    height: 70vh;
    overflow: visible;
  }

  .experience__track {
    position: relative;
    width: 100%;
    height: 100%;
    /* overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
     */
    scrollbar-width: none;
  }
  .experience__track::-webkit-scrollbar { display: none; }

  .experience__card {
    position: absolute;
    width: clamp(20rem, 70vw, 90vw);
    height: 100%;
    max-height: 65vh;
    left: 50%;
    top: 50%;

    display: grid;
    grid-template-columns: 2fr 3fr;

    gap: 0.85rem;
    padding: 1rem;
    background: linear-gradient(135deg, var(--c-primary) 0%, #0c1f4a 80%);
    border-radius: 0.2rem;
    overflow: hidden;
    transform-origin: 50% 0%;
    /* No `will-change` here. Every card in the track would otherwise
     * sit on a permanent GPU layer from SSR, burning VRAM even before
     * the user scrolls to the section. The JS already promotes the
     * cards via `promoteCards()` on `onEnter` and releases them on
     * `onLeave` (see the ScrollTrigger below), so the layer is only
     * alive while the scrub is actually running.
     *
     * The `box-shadow` was also moved to a pseudo-element so the card
     * itself can be GPU-composited (transform-only) without re-painting
     * the shadow on every scrub frame. */
  }

  .experience__card::after {
    content: "";
    position: absolute;
    inset: -0.5rem;
    border-radius: 0.4rem;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.5);
    pointer-events: none;
    z-index: -1;
  }
  
  @media (aspect-ratio <= 1/1) {
    .experience__card {
      display: flex;
      flex-direction: column;
      justify-content: center; 
    }
  }
  

  /* Cards flagged as deferred are not part of the initial timeline and
     stay hidden until the user clicks "see all". Removing the attribute
     reveals them and triggers a timeline rebuild. */
  .experience__card[data-deferred] {
    display: none;
  }

  .experience__card-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    color: var(--c-text);
    overflow: hidden;
    font:  clamp(0.7rem, 5vw, 4rem) var(--ff-geist-pixel);
  }

  .experience__card-title {
    margin: 0;
    font-family: var(--ff-pixeloid);
    font-size: clamp(0.95rem, 5vw, 2rem);
    line-height: 1.15;
  }

  .experience__card-enterprises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .experience__card-enterprise {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: .8rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
    transition: color var(--t-fast) var(--ease-out);
  }
  .experience__card-enterprise:hover { color: var(--c-secondary); }

  .experience__card-enterprise-logo {
    width: min(1.5rem, 4vw);
    height: min(1.5rem, 4vw);
    
    border-radius: 0.25rem;
    object-fit: cover;
  }

  .experience__card-period {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
  }

  .experience__card-description {
    margin: 0;
    font-size: min(0.8rem, 2.4vw);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.85);
    max-height: 50vh;
    overflow-y: auto;
    font-family: var(--ff-pixeloid);
  }

  .experience__card-toggle {
    align-self: flex-start;
    padding: 0;
    font-family: var(--ff-pixeloid);
    font-size: 0.8rem;
    color: var(--c-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--t-fast) var(--ease-out);
  }
  .experience__card-toggle:hover { opacity: 0.8; }

  .experience__card-slider {
    position: relative;
    border-radius: 0.2rem;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.4);
    min-height: 10rem;
  }

  .experience__swiper { width: 100%; height: 100%; }
  .experience__swiper-wrapper { height: 100%; }
  .experience__swiper-slide {
    height: 100%;
    background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.05), rgba(0,0,0,0.4));
  }
  .experience__swiper-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .experience__swiper-nav {
    color: var(--c-secondary);
    opacity: 0.35;
    transition: opacity var(--t-fast) var(--ease-out);
  }
  .experience__swiper-nav:hover { opacity: 1; }

  .experience__card-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.85rem;
  }

  .experience__card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    opacity: 0;
    transform: translateY(100%);
    transition: opacity var(--t-med) var(--ease-out), transform var(--t-med) var(--ease-out);
    pointer-events: none;
    z-index: 10;
    max-height: 70%;
  }
  .experience__card.is-expanded .experience__card-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .experience__card-overlay-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    height: 100%;
    overflow-y: auto;
  }

  .experience__card-techs {
    display: flex;
    flex-wrap: wrap;
    justify-content: start;
    gap: 0.4rem;
  }

  .experience__card-tech {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(0, 181, 232, 0.15);
    color: var(--c-secondary);
    border: 1px solid rgba(0, 181, 232, 0.3);
    font-size: 0.72rem;
    font-family: var(--ff-pixeloid);
    opacity: 0;
    transform: translate(5rem,0);
    transition: opacity var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
  }
  .experience__card.is-expanded .experience__card-tech { opacity: 1; transform: translate(0,0); }

  .experience__card-content {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.75);
    max-width: 90%;
    font-family: var( --ff-pixeloid);
    line-height: 1.5;
    overflow-y: auto;
    text-align: justify;
    /* make a fade out to the bottom */
    padding-bottom: 3rem;
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 1rem, rgba(0, 0, 0, 1) 3rem);
  }
  .experience__card-content :global(a) {
    text-decoration: underline;
    color: var(--c-secondary);
  }
  .experience__card-content :global(strong) { color: var(--c-text); }

  .experience__card-close {
    position: absolute;
    z-index: 2;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 1.5rem;
    font-family: var(--ff-pixeloid);
    line-height: 1;
    color: var(--c-text);
    transition: all var(--t-fast) var(--ease-out);
  }
  .experience__card-close:hover { color: var(--c-secondary); scale: 0.9; }

  .experience__controls {
    display: flex;
    justify-content: center;
  }

  .experience__see-all {
    padding: 0.65rem 1.5rem;
    border: 1px solid var(--c-secondary);
    border-radius: 999px;
    font-family: var(--ff-pixeloid);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-secondary);
    background-color: rgba(17, 0, 255, 0.3);
    box-shadow: 0 0 1rem var(--c-secondary);
    transition: all var(--t-fast) var(--ease-out);
  }
  .experience__see-all:hover {
    background: var(--c-secondary);
    color: var(--c-bg);
  }
  .experience__see-all:disabled {
    box-shadow: none;
    background-color: none;
    opacity: 0.9;
    cursor: not-allowed;
    border-color: rgb(171, 171, 171);
    color: rgb(171, 171, 171);
    background: rgba(171, 171, 171, 0.1);
  }
  .experience__see-all:disabled:hover {
    background: rgba(171, 171, 171, 0.3);
  }

  /* ScrollTrigger wraps the pinned element in a fixed-position container.
     Force it to truly cover the viewport so the pin feels seamless. */
  :global(.pin-spacer) > .experience-content {
    width: 100%;
  }

  /* Cards are absolutely positioned inside the track once GSAP takes
     over, so we drop the flex layout for them and let GSAP own x/y. */
  .experience-track {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Clickable wrapper around the swiper image. Renders as a transparent
     button so the <img> stays a normal element (lightbox CSS hooks
     `data-lightbox-src` via the parent button). We reset the native
     button styles and keep the click target covering the whole slide. */
  .experience__swiper-image-button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    overflow: hidden;
  }
  .experience__swiper-image-button::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: background var(--t-fast) var(--ease-out);
    pointer-events: none;
  }
  .experience__swiper-image-button:hover::after {
    background: rgba(0, 0, 0, 0.25);
  }
  .experience__swiper-image-button:focus-visible {
    outline: 2px solid var(--c-secondary);
    outline-offset: -2px;
  }

  /* Fullscreen image lightbox. Fixed to the viewport so it floats
     above the pinned section / ScrollTrigger wrappers. The `is-open`
     class drives opacity + transform for a snappy open/close. */
  .experience__lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(5, 8, 22, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--t-med) var(--ease-out),
      visibility var(--t-med) var(--ease-out);
  }
  .experience__lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .experience__lightbox-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform: scale(0.95);
    transition: transform var(--t-med) var(--ease-out);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.6);
    border-radius: 0.25rem;
  }
  .experience__lightbox.is-open .experience__lightbox-image {
    transform: scale(1);
  }

  .experience__lightbox-close {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.25rem;
    line-height: 1.25;
    font-family: var(--ff-pixeloid);
    padding: 0 0 0.15rem 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    color: var(--c-text);
    cursor: pointer;
    z-index: 2;
    
    transition:
      background var(--t-fast) var(--ease-out),
      transform var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }
  .experience__lightbox-close:hover {
    background: var(--c-secondary);
    color: var(--c-bg);
    border-color: var(--c-secondary);
  }

</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  gsap.registerPlugin(ScrollTrigger);

  interface ExperienceAnimationHandle {
    timeline: gsap.core.Timeline;
    scrollTrigger: ScrollTrigger;
    destroy: () => void;
  }

  /**
   * Build the scroll-driven card stack animation.
   *
   * Logic ported from the reference snippet, adapted to the existing
   * markup (`.experience-track` / `.experience-card` /
   * `#experienceDetailedView` / `.experience-content`).
   *
   * - One viewport of scroll per card transition.
   * - Cards after the first start at `x: 100vw` and slide in.
   * - As each new card enters, the previous stack shifts up-left by
   *   `STACK_OFFSET_PX`, creating the partial-visible "deck" look.
   * - The timeline is scrubbed and snapped to per-card labels so the
   *   user always lands cleanly on a card.
   */
  const buildExperienceScroll = (): ExperienceAnimationHandle | null => {

    const root = document.getElementById('experienceDetailedView');
    if (!root) return null;

    const cards = Array.from(
      root.querySelectorAll<HTMLElement>('.experience__card'),
    ).filter((c) => !c.hasAttribute('data-deferred'));

    const numCards = cards.length;
    if (numCards === 0) return null;

    // Reduced-motion fallback: lay all cards in a static horizontal
    // strip (no pin, no scrub) so the section is still navigable and
    // the user can read every card without triggering the long pinned
    // scroll animation. We trade the deck-of-cards effect for
    // accessibility.
    if (
      typeof window !== 'undefined' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const track = root.querySelector<HTMLElement>('.experience__track');
      if (track) {
        track.style.display = 'flex';
        track.style.flexDirection = 'row';
        track.style.gap = '1rem';
        track.style.overflowX = 'auto';
      }
      for (const card of cards) {
        card.style.position = 'relative';
        card.style.left = 'auto';
        card.style.top = 'auto';
        card.style.transform = 'none';
        card.style.opacity = '1';
      }
      return null;
    }


    const STEP_DURATION = 1;
    const STACK_OFFSET_PERCENTAGE = 4;

    const timeline = gsap.timeline({
      paused: true,
      defaults: { ease: 'power2.inOut' },
      onComplete: () => {
        const btn = document.querySelector<HTMLElement>(
          '[data-experience-see-all]',
        );
        if (btn?.hasAttribute('disabled')) {
          btn.removeAttribute('disabled');
        }
      },
    });
    
    timeline.set(cards[0], { scale: 1, yPercent: -50, xPercent: -50, opacity: 1 });
    cards.slice(1).forEach((card) => { timeline.set(card, { xPercent: -50, yPercent: 50, opacity: 0 })});
    timeline.addLabel('card-0', 0);

    
    
    // // For each new card k (1..N-1):
    // //   - every visible card shifts up-left by STACK_OFFSET (the deck)
    // //   - card[k] slides in from the right
    cards.forEach((_, step) => {
      if (step === 0) return;

      const segmentTime = (step - 1) * STEP_DURATION;
      
      cards.slice(0, step).forEach((_, i) => {
        const animationParams = {
        scale: 0.9 - 0.05 * (step - i),
        yPercent: - (50 + STACK_OFFSET_PERCENTAGE * (step - i)),
        opacity: 0.5,
        duration: STEP_DURATION,
        };
        // card out animation
        timeline.to(
          cards[i],
          animationParams,
          segmentTime,
        );
      });

      
      // card entry animation
      timeline.to(
        cards[step],
        { 
         scale: 1,
         yPercent: -50,
         opacity: 1, duration: STEP_DURATION 
        },
        segmentTime,
      );
      timeline.addLabel(`card-${step}-start`, segmentTime);
      timeline.addLabel(`card-${step}-end`, segmentTime + STEP_DURATION);
    });


    // The pin/scrub lasts for the full scroll distance, so during that
    // window the cards are continuously transformed. Promote them to a
    // GPU layer only while the trigger is active, then release it so
    // the layers don't burn VRAM after the section is offscreen.
    const promoteCards = () => gsap.set(cards, { willChange: 'transform, opacity' });
    const demoteCards = () => gsap.set(cards, { willChange: 'auto' });

    const st = ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: `+=${numCards * 500}`,
      scrub: 0.4,
      pin: true,
      snap: {
        snapTo: 'labels',
        duration: 0.3,
        ease: 'power1.inOut',
      },
      
      animation: timeline,
      onEnter: promoteCards,
      onEnterBack: promoteCards,
      onLeave: demoteCards,
      onLeaveBack: demoteCards,
    });

    return {
      timeline,
      scrollTrigger: st,
      destroy: () => {
        st.kill();
        timeline.kill();
      },
    };
  };

  /**
   * Initialize Swiper instances for all non-deferred experience card swipers.
   * Called on page load and again after deferred cards are revealed.
   */
  const initSwipers = () => {
    document
      .querySelectorAll<HTMLElement>('[data-experience-swiper]')
      .forEach((el) => {
        // Skip swipers inside deferred cards â€” they are display:none and
        // Swiper would otherwise try to measure a zero-sized container.
        if (el.closest('.experience__card[data-deferred]')) return;
        const cardId = el.getAttribute('data-card-id');
        if (!cardId) return;
        new Swiper(el, {
          modules: [Navigation, Pagination, Autoplay],
          direction: 'horizontal',
          loop: true,
          grabCursor: true,
          autoplay: { delay: Math.floor(Math.random() * 20_000) + 8000, disableOnInteraction: false },
          pagination: {
            el: el.querySelector(
              `.experience__swiper-pagination-${cardId}`,
            ) as HTMLElement,
            clickable: true,
          },
          navigation: {
            prevEl: el.querySelector(
              '.swiper-button-prev',
            ) as HTMLElement,
            nextEl: el.querySelector(
              '.swiper-button-next',
            ) as HTMLElement,
          },
          observer: true,
          observeParents: true,
        });
      });
  };

  const init = () => {
    // Initialize Swiper carousels for visible cards.
    initSwipers();

    // Scroll-driven card stack. The handle is kept so we can tear it
    // down and rebuild once the deferred cards are revealed.
    const root = document.getElementById('experienceDetailedView');
    let experienceHandle: ExperienceAnimationHandle | null = null;
    if (root) experienceHandle = buildExperienceScroll();

    // Lightbox: opens when a swiper image is clicked, closes via the X
    // button, the backdrop, or the Escape key. The image source/alt are
    // pulled from the trigger's `data-lightbox-*` attributes. While
    // open we lock body scroll so the page underneath doesn't drift
    // (the pinned ScrollTrigger would otherwise consume wheel input).
    const lightbox = document.querySelector<HTMLElement>(
      '[data-experience-lightbox]',
    );
    const lightboxImage = document.querySelector<HTMLImageElement>(
      '[data-experience-lightbox-image]',
    );
    const lightboxClose = document.querySelector<HTMLElement>(
      '[data-experience-lightbox-close]',
    );

    const openLightbox = (src: string, alt: string) => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    if (lightbox) {
      // Click on the backdrop (not on the image itself) closes the
      // lightbox. We delegate to the lightbox container and ignore
      // events whose target is the inner image.
      lightbox.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (
          target.closest('[data-experience-lightbox-close]') ||
          target.closest('[data-experience-lightbox-image]')
        ) {
          return;
        }
        closeLightbox();
      });
    }

    lightboxClose?.addEventListener('click', closeLightbox);

    // Delegated handler so it keeps working for deferred cards that
    // are revealed later. The button is the <button> wrapper around
    // the <img>, not the img itself, so we look for the closest match.
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>(
        '[data-lightbox-src]',
      );
      if (!trigger) return;
      // Swiper slides can receive clicks via Swiper's internal handlers;
      // stopPropagation here keeps the card expand/collapse listener
      // from also toggling `is-expanded` on the parent card.
      e.stopPropagation();
      e.preventDefault();
      const src = trigger.getAttribute('data-lightbox-src');
      const alt = trigger.getAttribute('data-lightbox-alt') ?? '';
      if (src) openLightbox(src, alt);
    });

    // Escape closes the lightbox regardless of focus. Bound at init so
    // it works even after the user has tabbed into a swiper control.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('is-open')) {
        closeLightbox();
      }
    });

    // "See all" button: unhides every deferred card, rebuilds the
    // scroll-driven timeline so they join the deck, then hides itself.
    const seeAllBtn = document.querySelector<HTMLElement>(
      '[data-experience-see-all]',
    );
    seeAllBtn?.addEventListener('click', () => {
      if (!root) return;
      const deferred = root.querySelectorAll<HTMLElement>( '.experience__card[data-deferred]', );
      if (deferred.length > 0) {
        deferred.forEach((card) => card.removeAttribute('data-deferred'));
        experienceHandle?.destroy();
        experienceHandle = buildExperienceScroll();
        // Initialize Swipers for the newly revealed cards.
        initSwipers();
        ScrollTrigger.sort();
        ScrollTrigger.refresh();
      }
      seeAllBtn.style.display = 'none';
    });


    // Card expand/collapse interactions.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const toggle = target.closest<HTMLElement>('[data-experience-toggle]');
      const techs = document.querySelectorAll<HTMLElement>('.experience__card-tech');
      if (toggle) { // open
        e.stopPropagation();
        const id = toggle.getAttribute('data-experience-toggle');
        document
          .getElementById(`experienceCard-${id}`)
          ?.classList.toggle('is-expanded');

        return;
      }
      const close = target.closest<HTMLElement>('[data-experience-close]');
      if (close) {
        e.stopPropagation();
        const id = close.getAttribute('data-experience-close');
        document
          .getElementById(`experienceCard-${id}`)
          ?.classList.remove('is-expanded');
          // make it instant to the techs
          techs.forEach((tech) => { tech.style.transitionDelay = '0ms'; });
          setTimeout(() => {
            // restore the original delay after a short time
            techs.forEach((tech) => {
              const delay = tech.getAttribute('data-delay');
              if (delay) {
                tech.style.transitionDelay = `${delay}ms`;
              }
            });
          }, 5);
        return;
      }
      const card = target.closest<HTMLElement>(
        '.experience__card.is-expanded',
      );
      
      
      if (
        card &&
        !target.closest('.experience__card-content') &&
        !target.closest('.experience__card-overlay')
      ) {
        card.classList.remove('is-expanded');
        // make it instant to the techs
        techs.forEach((tech) => { tech.style.transitionDelay = '0ms'; });
        setTimeout(() => {
          // restore the original delay after a short time
          techs.forEach((tech) => {
            const delay = tech.getAttribute('data-delay');
            if (delay) {
              tech.style.transitionDelay = `${delay}ms`;
            }
          });
        }, 5);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
