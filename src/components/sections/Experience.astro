    pointer-events: none;
    z-index: 10;
    max-height: 70%;
  }
  .experience__card.is-expanded .experience__card-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .experience__card-overlay-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    height: 100%;
    overflow-y: auto;
  }

  .experience__card-techs {
    display: flex;
    flex-wrap: wrap;
    justify-content: start;
    gap: 0.4rem;
  }

  .experience__card-tech {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(0, 181, 232, 0.15);
    color: var(--c-secondary);
    border: 1px solid rgba(0, 181, 232, 0.3);
    font-size: 0.72rem;
    font-family: var(--ff-pixeloid);
