---
import '../styles/global.css';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props as Props;
const pageTitle = title ?? t(lang, 'site.title');
const pageDescription = description ?? t(lang, 'site.description');
---
<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preload" as="image" href="/me.png" />
    <link rel="preload" as="font" type="font/ttf" href="/fonts/PixeloidSans.ttf" crossorigin />
    <!-- <link rel="preload" as="font" type="font/ttf" href="/fonts/Tr2n.ttf" crossorigin /> -->

    <!-- Optional head slot: pages can inject extra <link>, <meta>, etc. here
         (e.g. per-page image preloads). Renders nothing if unused. -->
    <slot name="head" />

    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

